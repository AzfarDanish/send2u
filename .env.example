# Send2U environment template — copy to `.env` and fill in values.
# Never commit real keys (`.env` is gitignored).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Credential-free development auth (anonymous Supabase session + role picker).
# Set to 1 for local MVP development. Never enable in production builds.
EXPO_PUBLIC_SEND2U_DEV_AUTH=
# Supabase SECRET service-role key (server-side use ONLY).
# DANGER: bypasses Row Level Security. NEVER prefix with EXPO_PUBLIC_ (that
# would embed it in the shipped app), NEVER reference it from app code, NEVER
# commit it. Paste the value directly into your local `.env` from the
# Supabase Dashboard (Project Settings → API Keys) — never share it in chat.
SUPABASE_SERVICE_ROLE_KEY=
